{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/send-email.js": { "maxDuration": 60 },
    "api/admin-ops.js": { "maxDuration": 30 },
    "api/email-automation-cron.js": { "maxDuration": 60 },
    "api/feedback-form.js": { "maxDuration": 15 }
  },
  "crons": [
    { "path": "/api/email-automation-cron", "schedule": "0 8 * * *" }
  ],
  "rewrites": [
    { "source": "/api/paystack-webhook", "destination": "/api/paystack-webhook.js" },
    { "source": "/api/paystack-verify",  "destination": "/api/paystack-verify.js"  },
    { "source": "/api/paystack-intent",  "destination": "/api/paystack-intent.js"  },
    { "source": "/api/paystack-donation-verify", "destination": "/api/paystack-donation-verify.js" },
    { "source": "/api/admin-ops",        "destination": "/api/admin-ops.js"        },
    { "source": "/api/send-email",       "destination": "/api/send-email.js"       },
    { "source": "/api/email-automation-cron", "destination": "/api/email-automation-cron.js" },
    { "source": "/api/feedback-form",    "destination": "/api/feedback-form.js"    },
    { "source": "/ad-click/:id",        "destination": "/api/ad-click/:id"         },
    { "source": "/calculator",           "destination": "/calculator.html"          },
    { "source": "/payslip",              "destination": "/payslip-generator-kenya.html" },
    { "source": "/blog",                 "destination": "/blog.html"                },
    { "source": "/faq",                  "destination": "/faq.html"                 },
    { "source": "/salary-news",          "destination": "/salary-news.html"         },
    { "source": "/salary-index",         "destination": "/salary-index.html"        },
    { "source": "/auth",                 "destination": "/auth.html"                },
    { "source": "/account",              "destination": "/account.html"             },
    { "source": "/contact-us",           "destination": "/contact-us.html"          },
    { "source": "/donate",               "destination": "/donate.html"               },
    { "source": "/premium-thank-you",    "destination": "/premium-thank-you.html"   },
    { "source": "/salary/:path+",        "destination": "/salary/:path.html"        },
    { "source": "/blog/:path+",          "destination": "/:path.html"               }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control",          "value": "public, max-age=0, must-revalidate"  },
        { "key": "X-Content-Type-Options", "value": "nosniff"                             },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN"                          },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin"     }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "X-Robots-Tag",  "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store"          }
      ]
    }
  ]
}
