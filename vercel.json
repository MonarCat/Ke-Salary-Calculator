{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
    { "src": "/api/paystack-webhook", "dest": "/api/paystack-webhook.js" },
    { "src": "/api/paystack-verify",  "dest": "/api/paystack-verify.js"  },
    { "src": "/calculator",           "dest": "/calculator.html"         },
    { "src": "/payslip",              "dest": "/payslip.html"            },
    { "src": "/blog",                 "dest": "/blog.html"               },
    { "src": "/salary-news",          "dest": "/salary-news.html"        },
    { "src": "/salary-index",         "dest": "/salary-index.html"       },
    { "src": "/auth",                 "dest": "/auth.html"               },
    { "src": "/contact-us",           "dest": "/contact-us.html"         },
    { "src": "/premium-thank-you",    "dest": "/premium-thank-you.html"  },
    { "src": "/salary/(.+)",          "dest": "/salary/$1.html"          },
    { "src": "/blog/(.+)",            "dest": "/blog/$1.html"            },
    { "src": "/(.*)",                 "dest": "/index.html"              }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control",          "value": "public, max-age=0, must-revalidate"   },
        { "key": "X-Content-Type-Options", "value": "nosniff"                              },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN"                           },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin"      }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  
}
